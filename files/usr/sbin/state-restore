#!/bin/sh
# Dry-run by default; --apply restores only files with no redaction marker.
. "${STATE_LIB:-/usr/lib/state-lib.sh}" || exit 1
FAULTLOG_CMD=${FAULTLOG_CMD:-/usr/sbin/faultlog}
[ $# -ge 1 ] || { printf 'usage: state-restore <tag> [--dry-run|--apply]\n' >&2; exit 2; }
tag=$(state_clean_tag "$1")
[ -n "$tag" ] || exit 2
mode=${2:---dry-run}
case "$mode" in --dry-run|--apply) ;; *) exit 2;; esac
base=$(state_dir)
archive=$(ls -1d "$base"/*-"$tag" 2>/dev/null | sed -n '$p')  # newest by timestamped name
[ -d "$archive" ] && [ -f "$archive/MANIFEST.sha256" ] || exit 1
while read -r expected rel; do
  [ -f "$archive/$rel" ] || exit 1
  actual=$(sha256sum "$archive/$rel" | cut -d' ' -f1)
  [ "$actual" = "$expected" ] || exit 1
done < "$archive/MANIFEST.sha256"
if [ "$mode" = --apply ]; then
  # pre-restore may prune the selected oldest generation. Stage the already
  # verified archive in RAM before creating that new generation.
  staged=$(mktemp -d "${TMPDIR:-/tmp}/state-restore.XXXXXX") || exit 1
  trap 'rm -rf "$staged"' EXIT HUP INT TERM
  cp -R "$archive" "$staged/archive" || exit 1
  archive=$staged/archive
  while read -r expected rel; do
    actual=$(sha256sum "$archive/$rel" 2>/dev/null | cut -d' ' -f1)
    [ "$actual" = "$expected" ] || exit 1
  done < "$archive/MANIFEST.sha256"
  "${STATE_SAVE_CMD:-/usr/sbin/state-save}" pre-restore >/dev/null || exit 1
fi
skipped=0
while read -r expected rel; do
  case "$rel" in
    ./etc/config/*|./usr/sbin/*|./usr/lib/*|./etc/hotplug.d/iface/9*|./etc/hotplug.d/block/99-faultlog-usb|./etc/crontabs/root|./etc/sysupgrade.conf|./lib/adblock-fast/adblock-fast.uc|./etc/init.d/adblock-cache-preload|./etc/apk/world) ;;
    *) continue;;
  esac
  target=$(state_source "${rel#.}")
  if [ "$mode" = --dry-run ]; then
    if [ -f "$target" ]; then
      current=$(mktemp "${TMPDIR:-/tmp}/state-current.XXXXXX") || exit 1
      state_redact < "$target" > "$current"
      if command -v diff >/dev/null 2>&1; then
        diff -u "$current" "$archive/$rel" || :
      elif ! cmp -s "$current" "$archive/$rel"; then
        printf 'CHANGED : %s\n' "$rel"
      fi
      rm -f "$current"
    else printf 'MISSING : %s\n' "$rel"; fi
    if grep -q '\[REDACTED\]' "$archive/$rel"; then
      printf 'REDACTED : %s (apply will skip)\n' "$rel"
    fi
  else
    if grep -q '\[REDACTED\]' "$archive/$rel"; then
      printf 'SKIP redacted : %s\n' "$rel"
      skipped=$((skipped + 1))
      continue
    fi
    mkdir -p "${target%/*}" || exit 1
    cp "$archive/$rel" "$target" || exit 1
    case "$rel" in
      ./usr/sbin/*|./etc/hotplug.d/*|./etc/init.d/*) chmod 755 "$target" || exit 1;;
      ./usr/lib/*|./lib/adblock-fast/*|./etc/apk/world) chmod 644 "$target" || exit 1;;
    esac
    "$FAULTLOG_CMD" state info "action=restore result=copied path=${rel#./}" || :
  fi
done < "$archive/MANIFEST.sha256"
"$FAULTLOG_CMD" state info "action=restore result=$([ "$mode" = --apply ] && printf applied || printf dry_run) tag=$tag skipped=$skipped" || :
[ "$skipped" -eq 0 ] || exit 2
exit 0
